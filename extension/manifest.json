{
  "manifest_version": 3,
  "name": "Brunahólf · Mail Pulse",
  "short_name": "Brunaholf Mail",
  "version": "0.1.0",
  "description": "Skannar opna Gmail/Outlook flipa og sendir póst-metadata á brunahólf hub-ið — kemur í staðinn fyrir luna-bridge.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "https://brunaholf.netlify.app/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Brunahólf Mail Pulse",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content-gmail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.office.com/mail/*",
        "https://outlook.office365.com/mail/*",
        "https://outlook.live.com/mail/*"
      ],
      "js": ["content-outlook.js"],
      "run_at": "document_idle"
    }
  ]
}
